# Copy this file to .env and adjust for your machine.
# See the Gochin README for the full list of settings and their defaults.

# --- Server ---
GOCHIN_HOST=localhost
GOCHIN_PORT=8080
GOCHIN_ENV=development
# GOCHIN_DEBUG defaults to true outside production; leave unset unless you
# need to override it.
GOCHIN_API_PREFIX=/api

# --- Database ---
GOCHIN_DB_HOST=localhost
GOCHIN_DB_PORT=5432
GOCHIN_DB_USER=postgres
GOCHIN_DB_PASSWORD=
GOCHIN_DB_NAME={{.Name}}_db
GOCHIN_DB_SSL_MODE=disable

# --- Auth ---
GOCHIN_AUTH_TOKEN_TTL_HOURS=720
GOCHIN_LOGIN_RATE_PER_MINUTE=5

# --- Mail ---
# "log" writes mail to storage/logs instead of sending it — safe default for
# development. Switch to "smtp" and fill in the fields below to send for real.
GOCHIN_MAIL_DRIVER=log
GOCHIN_MAIL_FROM_ADDRESS=no-reply@{{.Name}}.test
GOCHIN_MAIL_FROM_NAME={{.Name}}
